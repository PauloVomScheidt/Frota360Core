      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{service_name=\"frota360-api\", deployment_environment_name=~\"$ambiente\", http_response_status_code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}} {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
