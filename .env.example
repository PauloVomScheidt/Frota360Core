# Configuração de produção do Frota360 — MODELO, sem valores.
#
# Copie para .env NA INSTÂNCIA (nunca no git), preencha e proteja:
#   cp .env.example .env && chmod 600 .env
#
# Na fase seguinte estes valores vêm do AWS SSM Parameter Store; um script de boot gera este
# mesmo arquivo com `aws ssm get-parameters-by-path --with-decryption`, sem alterar o compose.
#
# A aplicação FALHA NO BOOT, com mensagem dizendo o que falta, se algum obrigatório estiver
# ausente — ver ValidarConfiguracaoDeProducao em InfrastructureExtensions.cs.

# --- Banco --------------------------------------------------------------------
# Usados pelo container do Postgres. Use um usuário dedicado, não `postgres`.
POSTGRES_DB=frota360
POSTGRES_USER=frota360
POSTGRES_PASSWORD=

# Lida pela API. O host é o NOME DO SERVIÇO no compose (`db`), não localhost.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=frota360;Username=frota360;Password=

# --- Autenticação -------------------------------------------------------------
# Mínimo 32 caracteres — abaixo disso a aplicação não sobe. Gere com:
#   openssl rand -base64 48
Jwt__Key=
# Issuer e Audience têm padrão em appsettings.json (versionado); só defina para sobrescrever.

# --- Fronteira com o front ----------------------------------------------------
# Origem exata do front. Só `app.` entra: o domínio raiz redireciona para ele, e um redirect
# 3xx troca a origem do documento antes de qualquer requisição sair.
Cors__AllowedOrigins__0=https://app.frota360app.com.br

# Base dos links de convite e reset de senha. O link fica {BaseUrl}/convite?token=... e depende
# do fallback de SPA no CloudFront (403/404 -> /index.html) para abrir.
Frontend__BaseUrl=https://app.frota360app.com.br

# --- Backoffice ---------------------------------------------------------------
# Protege o provisionamento de empresa. Sem ela é IMPOSSÍVEL cadastrar a primeira empresa.
#   openssl rand -hex 32
Backoffice__ApiKey=

# --- E-mail (opcional) --------------------------------------------------------
# Sem a chave o sistema cai no LogEmailService: nada é enviado de verdade, só registrado no
# log, e um aviso aparece na inicialização.
Resend__ApiKey=

# Só o endereço — o nome de exibição ("Frota360 <...>") é montado no ResendEmailService.
Resend__From=nao-responda@send.frota360app.com.br

# Opcional. Um remetente "não responda" sem destino de resposta é penalizado pelos filtros de
# spam; preencha quando houver uma caixa que alguém leia.
Resend__ReplyTo=

# --- Proxy reverso ------------------------------------------------------------
# Usados pelo Caddyfile para emitir o certificado TLS.
#
# O registro de api. no Cloudflare precisa ficar em DNS-only (nuvem cinza). Proxiado, o
# Cloudflare intercepta as portas 80 e 443 e o desafio HTTP-01 do Let's Encrypt nunca chega
# à instância — o Caddy fica tentando em loop e o TLS nunca sobe.
DOMINIO_API=api.frota360app.com.br

# Só recebe aviso de falha na renovação do certificado; não aparece em nada público.
EMAIL_ACME=
